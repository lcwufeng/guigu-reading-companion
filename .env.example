DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_TIMEOUT_MS=20000
VOLC_SPEECH_APP_ID=
VOLC_SPEECH_ACCESS_TOKEN=
VOLC_SPEECH_SECRET_KEY=
VOLC_SPEECH_RESOURCE_ID=volc.bigasr.sauc.duration
VOLC_SPEECH_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream

# 书房朗读采用火山精品长文本异步合成；音色在生成脚本中固定为“温柔淑女” BV104_streaming。
# 若语音识别与语音合成使用同一应用，可沿用上面的 AppID 与 AccessToken。
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_RESOURCE_ID=volc.tts_async.default
BOOK_AUDIO_DIR=
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5
MIMO_API_URL=https://api.xiaomimimo.com/v1/chat/completions
MIMO_TIMEOUT_MS=25000
MODEL_CONFIG_ENCRYPTION_KEY=

# 火山等普通 Node 服务器使用单文件 SQLite；Sites 环境继续使用 D1，不设置此项。
APP_DATABASE_FILE=
CHAT_RETENTION_DAYS=14

# 仅限首次初始化测试环境时临时设为 1。生产环境创建账号后应移除，避免重新生成公开初始账号。
SEED_INITIAL_STUDENT_ACCOUNTS=

# 非 Cloudflare 服务器部署时，内测账号、学生状态与错题照片使用本地持久化目录。
AUTH_STORE_FILE=
USER_STATE_FILE=
MISTAKE_IMAGE_DIR=

# 非 Cloudflare 服务器部署时，用本地文件持久化每个账号的阅读进度。
READING_PROGRESS_FILE=

# 非 Cloudflare 服务器部署时，用本地文件保存每个账号的学生记忆；内容不在学生界面展示。
STUDENT_MEMORY_FILE=
